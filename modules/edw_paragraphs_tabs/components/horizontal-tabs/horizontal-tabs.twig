{#
/**
  * @file
  * Horizontal Tabs component.
  *
  * Available variables:
  *
  * Available properties:
  * - tabs (array)
  *
  * Available Utility classes -> uc
  * - horizontal_tabs_uc (array) (default: [''])
  *
  * Available attributes -> att
  * - horizontal_tabs_att (Drupal\Core\Template\Attribute)
  *
  * Available slots
  * - slot_content: The content for the button
  *
  * Coming soon: @see horizontal-tabs.md
  *
  */
#}

{# Set default value #}
{% set tabs = tabs|default(null) %}

{# Create attributres #}
{% set horizontal_tabs_att = horizontal_tabs_att ?: create_attribute() %}

{# Component classes #}
{% set horizontal_tabs_classes = [
  'comp--horizontal_tabs',
  'horizontal-tabs',
]|merge(horizontal_tabs_uc ?: []) %}

{# Change attributres #}
{# Render component #}
<div{{ horizontal_tabs_att.addClass(horizontal_tabs_classes) }}>
  <ul class="horizontal-tabs__nav" role="tablist">
    {% for tab in horizontal_tabs_tabs %}
      <li role="presentation" class="horizontal-tabs__tab">
        <button id="tab-{{ loop.index }}" class="horizontal-tabs__button {% if loop.first %}is-active{% endif %}" role="tab" aria-controls="panel-{{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">
          {{ tab.title }}
        </button>
      </li>
    {% endfor %}
  </ul>

  <div class="horizontal-tabs__panels">
    {% for tab in horizontal_tabs_tabs %}
      <div id="content-{{ loop.index }}" class="horizontal-tabs__panel {% if loop.first %}is-active{% endif %}" role="tabpanel" aria-labelledby="tab-{{ loop.index }}" aria-hidden="{{ not loop.first ? 'true' : 'false' }}">
        {{ tab.content }}
      </div>
    {% endfor %}
  </div>
</div>
